{
  "entities": {
    "submitted_faces": {
      "title": "Submitted Faces",
      "description": "User-submitted faces for peopleguesser.io quiz",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "imageUrl": { "type": "string" },
        "category": { "type": "string" },
        "occupation": { "type": "string" },
        "origin": { "type": "string" },
        "funFact": { "type": "string" },
        "gender": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string" },
        "submittedBy": { "type": "string" }
      },
      "required": ["name", "imageUrl", "status"]
    }
  }
}
